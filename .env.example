# ========================================================
# SELEÇÃO DO PROVEDOR DE IA (OpenAI ou Google Gemini)
# ========================================================
# O sistema detecta automaticamente qual chave foi preenchida.
# Caso preencha ambas as chaves, você pode escolher explicitamente o provedor:
# AI_PROVIDER=openai   # opções: 'openai' ou 'gemini'
AI_PROVIDER=

# --- Configuração OpenAI ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL='text-embedding-3-small'
OPENAI_CHAT_MODEL='gpt-4o-mini'

# --- Configuração Google Gemini ---
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL='models/gemini-embedding-001'
GOOGLE_CHAT_MODEL='gemini-flash-lite-latest'

# ========================================================
# BANCO DE DADOS POSTGRESQL + PGVECTOR
# ========================================================
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PG_VECTOR_COLLECTION_NAME=documentos_fullcycle

# ========================================================
# PARÂMETROS DO PIPELINE RAG
# ========================================================
PDF_PATH=./document.pdf
TOP_K=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150